# ==========================================
# PRAGATHI SWEETS DOCKER COMPOSE CONFIGURATION
# Copy this file to .env before running: docker-compose up -d
# ==========================================

# Database Configuration
DB_NAME=pragathi_sweets
DB_ROOT_PASSWORD=change_this_root_password_in_prod
DB_USER=pragathi_user
DB_PASSWORD=change_this_user_password_in_prod

# JWT Secret (Base64-encoded, min 256 bits)
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVm

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>

# Initial Administrator Credentials
DEFAULT_ADMIN_EMAIL=<your-admin-email>
DEFAULT_ADMIN_PASSWORD=<your-admin-password>

# Gemini AI (Optional admin catalog assistance)
GEMINI_API_KEY=<your-gemini-api-key>

